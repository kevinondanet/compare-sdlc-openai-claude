{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeQL",
          "semanticVersion": "2.19.3",
          "rules": [
            {"id": "py/sql-injection", "properties": {"security-severity": "9.8", "problem.severity": "error"}},
            {"id": "py/clear-text-logging-sensitive-data", "properties": {"security-severity": "7.5"}},
            {"id": "py/unused-import", "properties": {"problem": {"severity": "recommendation"}}},
            {"id": "py/path-injection", "properties": {"security-severity": "7.5"}}
          ]
        }
      },
      "results": [
        {"ruleId": "py/sql-injection", "level": "error", "message": {"text": "SQL query built from user input"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "src/app/db.py"}, "region": {"startLine": 42}}}]},
        {"ruleId": "py/clear-text-logging-sensitive-data", "level": "error", "message": {"text": "Sensitive data logged"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "src/app/log.py"}, "region": {"startLine": 7}}}]},
        {"ruleId": "py/unused-import", "level": "note", "message": {"text": "Unused import"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "src/app/util.py"}, "region": {"startLine": 1}}}]},
        {"ruleId": "py/path-injection", "level": "error", "message": {"text": "Suppressed via inline comment"}, "suppressions": [{"kind": "inSource"}], "locations": [{"physicalLocation": {"artifactLocation": {"uri": "src/app/files.py"}, "region": {"startLine": 12}}}]},
        {"ruleId": "py/unknown-rule", "level": "warning", "message": {"text": "Something moderate"}}
      ]
    }
  ]
}
